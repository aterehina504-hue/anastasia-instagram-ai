# Application
APP_ENV=development
APP_TIMEZONE=Europe/Paris
ADMIN_USERNAME=admin
# Generate a strong password, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Public HTTPS origin that Meta can fetch media from; do not include a trailing slash.
# Example: https://social.example.com
PUBLIC_BASE_URL=https://your-public-domain.example
DOMAIN=your-public-domain.example
MEDIA_DIR=/data/media
POSTGRES_PASSWORD=replace-with-a-long-random-password

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
GENERATE_VISUALS=true

# Optional Reels video generation via Runway API. Leave blank to upload MP4 manually.
RUNWAY_API_KEY=
RUNWAY_RECIPE_VERSION=2026-06
# Runway multi-shot duration; API accepts 5, 10, or 15 seconds.
RUNWAY_VIDEO_DURATION=15

# Meta Graph API - Facebook Login flow; Instagram Business account linked to a Facebook Page
META_API_VERSION=v26.0
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# Database - local non-Docker run can use sqlite:///./instagram_ai.db
DATABASE_URL=postgresql+psycopg://instagram:change-me@db:5432/instagram_ai

# Optional font path for Russian text rendered into carousel/story images.
# Docker image installs DejaVu Sans at this path.
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Optional daily AI plan generation. Drafts require manual approval before publishing.
DAILY_DRAFTS_ENABLED=false
DAILY_DRAFT_COUNT=2
DAILY_GENERATION_HOUR=6
DAILY_GENERATION_MINUTE=0
BRAND_NAME=Anastasia | content creator
BRAND_INDUSTRY=Контент-креатор; специализацию уточнить по реальной ленте
BRAND_AUDIENCE=Подписчики и потенциальные заказчики; сегменты аудитории требуют подтверждения
BRAND_TONE=Живой, визуальный, уверенный, дружелюбный, авторский
BRAND_OFFER=Не заполнено: не придумывать услуги, цены, кейсы или результаты
DAILY_FORMATS=CAROUSEL,REEL,POST,STORY
